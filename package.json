{
  "name": "@atribu/tracker",
  "version": "0.1.3",
  "description": "Official Atribu tracking SDK — marketing attribution that shows which ads drive revenue",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "analytics",
    "attribution",
    "marketing",
    "tracking",
    "ads",
    "atribu"
  ],
  "author": "Atribu",
  "license": "MIT",
  "homepage": "https://www.atribu.app/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtribuCore/atribu-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/AtribuCore/atribu-tracker/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "@types/node": "^20.0.0"
  }
}
